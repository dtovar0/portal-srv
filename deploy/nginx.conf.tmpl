# @APP_TITLE@ tras Authelia.
#
# Reparto: Next.js sirve toda la interfaz; Flask es solo API. Ambos van bajo el
# mismo dominio para que la cookie de sesión que emite Flask llegue al frontend
# sin CORS.
#
# Los puertos de ambos upstream deben escuchar solo en loopback: el backend
# deduce la identidad SSO de cabeceras que únicamente este proxy debe poder
# inyectar.

upstream @APP_NAME@_api {
    server 127.0.0.1:@API_PORT@;
    keepalive 16;
}

upstream @APP_NAME@_web {
    server 127.0.0.1:@WEB_PORT@;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name @DOMAIN@;

    # ssl_certificate     /etc/ssl/certs/@APP_NAME@.crt;
    # ssl_certificate_key /etc/ssl/private/@APP_NAME@.key;

    client_max_body_size 64m;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- Defensa: sin cabeceras de identidad del cliente ------------------
    # El acceso es por OIDC con Authelia desde la app (ADR-009): el backend ya
    # no lee `Remote-*` ni hay `auth_request` aquí. Se conserva el borrado de
    # estas cabeceras si las envía el cliente, como defensa en profundidad.
    proxy_set_header Remote-Email  "";
    proxy_set_header Remote-Name   "";
    proxy_set_header Remote-Groups "";

    # --- Páginas de error corporativas (ADUANA) ----------------------------
    error_page 403 /errors/403.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 502 /errors/502.html;
    error_page 503 /errors/503.html;
    error_page 504 /errors/504.html;

    location ^~ /errors/ {
        alias @PREFIX@/deploy/errors/;
    }

    # Favicon directo desde el código (FNC-186): no depende de que el frontend
    # esté arriba (con Next caído, las páginas de error también lo muestran).
    location = /favicon.ico {
        alias @PREFIX@/frontend/public/favicon.ico;
        expires 7d;
        access_log off;
        log_not_found off;
    }

    # --- Backend Flask -----------------------------------------------------
    # La API (incluida la autenticación en `/api/v1/auth`, y el retorno de
    # Authelia en `/api/v1/auth/oidc/callback`). La cookie de sesión
    # se emite aquí, y como todo se sirve bajo el mismo dominio, el frontend la
    # envía sin CORS.
    location /api/ {
        proxy_pass http://@APP_NAME@_api;
        proxy_http_version 1.1;
    }

    # --- Frontend Next.js --------------------------------------------------
    location /_next/static/ {
        proxy_pass http://@APP_NAME@_web;
        proxy_http_version 1.1;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://@APP_NAME@_web;
        proxy_http_version 1.1;
        # Al definir `proxy_set_header` aquí, Nginx NO hereda los del nivel
        # `server`: se repiten, sobre todo el borrado de `Remote-*` (FNC-004),
        # porque Next reenvía `/api/*` al backend desde loopback. La prueba `tests/deploy/test_nginx_cabeceras.py` lo exige.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Remote-Email  "";
        proxy_set_header Remote-Name   "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
